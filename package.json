{
  "name": "icor-for-life-terminal",
  "version": "0.2.0",
  "private": true,
  "description": "ICOR for Life - Terminal - a real terminal inside your vault.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src styles.css",
    "pretest": "node test/build.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node tools/smoke-helper.mjs && node tools/smoke-typed.mjs",
    "gate": "npm run typecheck && npm run build && npm run lint && npm test && npm run smoke"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  }
}
